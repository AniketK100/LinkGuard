# LinkGuard Environment Configuration Template

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=http://localhost:8080

# Database Configuration (Neon PostgreSQL / Local Postgres)
DB_HOST=ep-cool-name-123456.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=linkguard_db
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_URL=jdbc:postgresql://ep-cool-name-123456.ap-southeast-1.aws.neon.tech:5432/linkguard_db?sslmode=require
DB_DRIVER=org.postgresql.Driver
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Cache Configuration (Upstash Redis / Local Redis)
REDIS_HOST=primary-swift-12345.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password_here
REDIS_SSL=true
REDIS_URL=rediss://default:your_upstash_redis_password_here@primary-swift-12345.upstash.io:6379

# Security & JWT Configuration (256-bit Random Secret Keys)
JWT_SECRET=generate_a_secure_256_bit_random_hex_or_base64_string_here
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
SECURITY_IP_HASH_SALT=generate_a_secure_256_bit_random_salt_string_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://linkguard.app

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_URL=http://localhost:3000
