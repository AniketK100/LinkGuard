# LinkGuard Environment Variables Configuration Template

# Server Port
PORT=8080

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=linkguard
DB_USER=linkguard_user
DB_PASSWORD=linkguard_secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Security Credentials & Expiration
JWT_SECRET=
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Anonymization Salt
IP_HASH_SALT=linkguard_ip_anonymization_salt
