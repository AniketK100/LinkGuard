# LinkGuard Environment Configuration Template

# Server Configuration
PORT=8080
APP_BASE_URL=http://localhost:8080

# Database Configuration (PostgreSQL 18)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=linkguard_db
DB_USERNAME=linkguard_user
DB_PASSWORD=linkguard_secret_pass

# Cache Configuration (Redis 8)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Configuration
JWT_SECRET=super_secret_jwt_key_must_be_at_least_256_bits_long_for_security
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
SECURITY_IP_HASH_SALT=linkguard_production_ip_anonymization_salt_key

# External Cloud Storage Placeholders (Cloudinary)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080
